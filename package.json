    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
